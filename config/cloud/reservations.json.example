{
  "AzureSecurity": {
    "Mode": "ManagedIdentity"
  },
  "ConnectionStrings": {
    "Runtime": "Server=tcp:tourlabazure-REPLACE.database.windows.net,1433;Database=tourlab_azure_study;Authentication=Active Directory Managed Identity;Encrypt=Strict;TrustServerCertificate=False;Max Pool Size=5;Connect Timeout=5"
  },
  "AllowedHosts": "tourlabazure-reservations-REPLACE.azurewebsites.net",
  "Ingress": {
    "KnownProxies": [
      "REPLACE_WITH_EXACT_PLATFORM_PROXY_IP"
    ]
  },
  "Messaging": {
    "Enabled": true,
    "FullyQualifiedNamespace": "tourlabazure-REPLACE.servicebus.windows.net"
  },
  "Jwt": {
    "ValidationKeys": [
      "REPLACE_WITH_GATEWAY_PUBLIC_SPKI_PEM"
    ]
  },
  "KeyVault": {
    "VaultUri": "https://tourlabazure-REPLACE.vault.azure.net/",
    "ExpectedSigningKeyId": "REPLACE_WITH_SHA256_OF_PUBLIC_SPKI",
    "SigningSecretIdentifier": "https://tourlabazure-REPLACE.vault.azure.net/secrets/tourlab-azure-quote-signing/REPLACE_WITH_EXACT_SECRET_VERSION"
  },
  "Catalog": {
    "BaseAddress": "https://tourlabazure-catalog-REPLACE.azurewebsites.net/"
  },
  "Dashboard": {
    "Enabled": true,
    "Local": false,
    "Endpoint": "https://tourlabazure-REPLACE.documents.azure.com/",
    "Database": "tourlab-azure-dashboard",
    "Container": "bookings",
    "KeyBlobUri": "https://tourlabazureREPLACE.blob.core.windows.net/tourlab-azure-dashboard-keys/cursor-ring.xml",
    "ProtectionKeyIdentifier": "https://tourlabazure-REPLACE.vault.azure.net/keys/tourlab-azure-dashboard-protection"
  }
}