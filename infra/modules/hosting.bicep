param prefix string
param location string
param tags object
param hostStorageName string
param hostBlobEndpoint string
@allowed(['B2','B3'])
param apiSku string
var apis = [ 'gateway', 'catalog', 'reservations', 'payments', 'notifications' ]
var assemblies = [ 'Gateway.Api', 'Catalog.Api', 'Reservations.Api', 'Payments.Api', 'Notifications.Api' ]
resource plan 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: '${prefix}-apis'
  location: location
  tags: tags
  kind: 'linux'
  sku: { name: apiSku, tier: 'Basic', capacity: 1 }
  properties: { reserved: true }
}
resource apps 'Microsoft.Web/sites@2024-11-01' = [for (w,i) in apis: {
  name: '${prefix}-${w}'
  location: location
  tags: tags
  kind: 'app,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    serverFarmId: plan.id
    httpsOnly: true
    publicNetworkAccess: 'Enabled'
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|10.0'
      appCommandLine: 'dotnet ${assemblies[i]}.dll'
      alwaysOn: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      http20Enabled: true
      healthCheckPath: '/health/live'
    }
  }
}]
resource scm 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = [for (w,i) in apis: {
  parent: apps[i]
  name: 'scm'
  properties: { allow: false }
}]
resource ftp 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = [for (w,i) in apis: {
  parent: apps[i]
  name: 'ftp'
  properties: { allow: false }
}]
resource flex 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: '${prefix}-flex'
  location: location
  tags: tags
  kind: 'functionapp'
  sku: { name: 'FC1', tier: 'FlexConsumption' }
  properties: { reserved: true }
}
resource function 'Microsoft.Web/sites@2024-11-01' = {
  name: '${prefix}-receipts'
  location: location
  tags: tags
  kind: 'functionapp,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    serverFarmId: flex.id
    httpsOnly: true
    publicNetworkAccess: 'Enabled'
    functionAppConfig: {
      deployment: { storage: {
        type: 'blobContainer'
        value: '${hostBlobEndpoint}tourlab-azure-deployments'
        authentication: { type: 'SystemAssignedIdentity' }
      } }
      runtime: { name: 'dotnet-isolated', version: '10.0' }
      scaleAndConcurrency: { maximumInstanceCount: 40, instanceMemoryMB: 2048 }
    }
    siteConfig: { ftpsState: 'Disabled', minTlsVersion: '1.2', scmMinTlsVersion: '1.2' }
  }
}
resource fscm 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: function
  name: 'scm'
  properties: { allow: false }
}
resource fftp 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: function
  name: 'ftp'
  properties: { allow: false }
}
resource host 'Microsoft.Storage/storageAccounts@2025-01-01' existing = { name: hostStorageName }
resource hostRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: host
  name: guid(host.id,function.id,'host-blob-owner')
  properties: { principalId: function.identity.principalId, principalType: 'ServicePrincipal', roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions','b7e6dc6d-f1e8-4753-8033-0f276bb0955b') }
}
output appNames array = [for (w,i) in apis: apps[i].name]
output appHosts array = [for (w,i) in apis: apps[i].properties.defaultHostName]
output principals array = [for (w,i) in apis: apps[i].identity.principalId]
output functionName string = function.name
output functionPrincipal string = function.identity.principalId
