    "knownProxies": {
      "value": {
        "gateway": [
          "REPLACE_EXACT_PLATFORM_PROXY_IP"
        ],
        "catalog": [
          "REPLACE_EXACT_PLATFORM_PROXY_IP"
        ],
        "reservations": [
          "REPLACE_EXACT_PLATFORM_PROXY_IP"
        ],
        "payments": [
          "REPLACE_EXACT_PLATFORM_PROXY_IP"
        ],
        "notifications": [
          "REPLACE_EXACT_PLATFORM_PROXY_IP"
        ]
      }
    },
    "humanPublicKeys": {
      "value": [
        "REPLACE_PUBLIC_SPKI_PEM"
      ]
    },
    "quotePublicKeys": {
      "value": [
        "REPLACE_PUBLIC_SPKI_PEM"
      ]
    },
    "humanSigningFingerprint": {
      "value": "REPLACE_SHA256_UPPERCASE"
    },
    "quoteSigningFingerprint": {
      "value": "REPLACE_SHA256_UPPERCASE"
    },
    "humanSecretVersion": {
